# Copy to .env (never commit .env) and fill in. docker compose reads it automatically.
# chmod 600 .env

# Public address of the app. Required for emailed links.
APP_URL=https://xlights.keithmarx.com

# Outgoing email for invites and password resets. Leave SMTP_HOST empty to disable email
# (admins are then shown the invite link to send themselves).
SMTP_HOST=mail.keithmarx.com
SMTP_PORT=587
SMTP_USER=noreply@keithmarx.com
SMTP_PASS=
MAIL_FROM=xLights Reference <noreply@keithmarx.com>

# Strongly recommended: required to create the first admin account, so nobody else can claim a fresh install.
ADMIN_SETUP_TOKEN=

# Optional. A random secret is generated into the data volume if empty.
SESSION_SECRET=

# Reverse proxies in front of the app (Apache = 1).
TRUST_PROXY=1
